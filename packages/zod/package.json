{
  "name": "@spndex/zod",
  "version": "1.0.0",
  "description": "Package which exports all Spndex zod schemas and types",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")"
