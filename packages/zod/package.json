    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3"
  }
}
